# Backend API URL
NEXT_PUBLIC_API_URL=https://imba.bet

# Backend superuser token (server-only, NOT NEXT_PUBLIC_)
SUPERUSER_TOKEN=

# NextAuth
NEXTAUTH_URL=https://cdn.imba.bet
NEXTAUTH_SECRET=

# Google OAuth — https://console.cloud.google.com/apis/credentials
# Redirect URI: https://cdn.imba.bet/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Allowed admin emails (comma-separated)
ADMIN_ALLOWED_EMAILS=admin@example.com,owner@example.com
