      var kk = document.getElementById("panel-kk");
      var he = document.getElementById("panel-he");
      var btnKk = document.getElementById("btn-kk");
      var btnHe = document.getElementById("btn-he");
      var isHe = lang === "he";
      kk.hidden = isHe;
      he.hidden = !isHe;
      btnKk.setAttribute("aria-pressed", isHe ? "false" : "true");
      btnHe.setAttribute("aria-pressed", isHe ? "true" : "false");
      document.documentElement.lang = isHe ? "he" : "kk-Latn";
      document.documentElement.dir = isHe ? "rtl" : "ltr";
      document.body.classList.toggle("lang-he", isHe);
      var pack = i18n[lang] || i18n.kk;
      document.title = pack.title;
      document.querySelectorAll("[data-i18n]").forEach(function (el) {
        var key = el.getAttribute("data-i18n");
        if (pack[key]) el.textContent = pack[key];
      });
      try { localStorage.setItem("ty_lang", lang); } catch (e) {}
    }
    document.getElementById("btn-kk").addEventListener("click", function () { setLang("kk"); });
    document.getElementById("btn-he").addEventListener("click", function () { setLang("he"); });
    var saved = null;
    try { saved = localStorage.getItem("ty_lang"); } catch (e) {}
    setLang(saved === "he" ? "he" : "kk");
  })();
  </script>
</body>
</html>`
    }
  }

  handle {
    header Content-Type "text/plain; charset=utf-8"
    respond "Gone" 410
  }

  tls {
    on_demand
  }
}

# Верифицированные кастомные домены магазинов (ask → kendall-store DB)
https:// {
  tls {
    on_demand
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  reverse_proxy kendall-store:3000
  encode gzip
}
