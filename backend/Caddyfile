kendall.kz {
  @www host www.kendall.kz
  redir @www https://kendall.kz{uri} permanent

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
  }

  # KZ ccTLD SEO: kendall.kz отдаёт контент kendall.network (Казахстанский регион)
  # Казахстанский ccTLD .kz даёт преимущество в ранжировании для KZ-аудитории в Google
  reverse_proxy kendall-network:3004
  encode gzip
  tls /etc/caddy/certs/kendall.kz.pem /etc/caddy/certs/kendall.kz.key
}

www.kendall.kz {
  redir https://kendall.kz{uri} permanent
  tls /etc/caddy/certs/kendall.kz.pem /etc/caddy/certs/kendall.kz.key
}

