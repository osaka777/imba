# WC / Olimpbet — isolated module (does not touch BetAPI)
WC_ODDS_MIN_STAKE=100
WC_ODDS_MAX_STAKE=1000000
WC_ODDS_TOLERANCE=0.02
WC_PROBE_SECRET=change-me-probe-secret
# Anonymous aggregate bet counts on the homepage. Safe default: off.
SOCIAL_PULSE_ENABLED=false
SOCIAL_PULSE_WINDOW_HOURS=24
SOCIAL_PULSE_MIN_BETS=2
# Firebase Cloud Messaging (APK push). JSON service account in one line.
FIREBASE_SERVICE_ACCOUNT_JSON=


# Olimpbet line (markets in WcOddsEvent.marketsJson).
WC_OLIMPBET_ENABLED=false
# Olimpbet sport ids: 100=football, 101=tennis, 102=basketball, 103=hockey, 124=cyber-basketball, 126=cyber-football
WC_OLIMPBET_SPORT_IDS=100,101,102,103,104,110,124,126,1001
# Optional tournament whitelist (empty = all leagues per sport)
WC_OLIMPBET_TOURNAMENT_IDS=
# Kick Dev API (client credentials) — live channel status for esports
KICK_DEV_CLIENT_ID=
KICK_DEV_CLIENT_SECRET=

# Twitch Helix API — EN fallback when Kick is offline (client credentials)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Optional: Olimpbet account for live broadcast streams (server login may be blocked by captcha)
WC_OLIMPBET_LOGIN=
WC_OLIMPBET_PASSWORD=
# Manual session cookie fallback (from browser after login on olimpbet.kz)
WC_OLIMPBET_BROADCAST_COOKIE=
