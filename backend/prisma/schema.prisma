/// "Связка" markets — a head-to-head race between two crypto symbols.
/// Winner = whichever leg has the larger % change from round open to round close.
model RaceRound {
  id          Int             @id @default(autoincrement())
  /// e.g. "BTCUSDT_DOGEUSDT" — identifies the pair regardless of roundMs.
  pairKey     String
  symbolA     String
  symbolB     String
  roundMs     Int             @default(300000)
  startsAt    DateTime
  endsAt      DateTime
  openPriceA  Decimal?        @db.Decimal(18, 8)
  openPriceB  Decimal?        @db.Decimal(18, 8)
  closePriceA Decimal?        @db.Decimal(18, 8)
  closePriceB Decimal?        @db.Decimal(18, 8)
  status      RaceRoundStatus @default(OPEN)
  result      RaceSide?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  bets        RaceBet[]

  @@unique([pairKey, startsAt, roundMs])
  @@index([status, endsAt])
  @@index([pairKey, roundMs, startsAt])
}

model RaceBet {
  id              Int           @id @default(autoincrement())
  userId          Int
  roundId         Int
  /// Which leg the player backed to outperform the other.
  side            RaceSide
  stake           Decimal       @db.Decimal(16, 2)
  currencyCode    String
  odds            Decimal       @db.Decimal(8, 2)
  potentialPayout Decimal       @db.Decimal(16, 2)
  status          RaceBetStatus @default(PENDING)
  settledAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id])
  round           RaceRound     @relation(fields: [roundId], references: [id])

  @@index([userId, status])
  @@index([roundId, status])
  @@index([userId, createdAt])
}

