/// House-odds event markets (Polymarket-style UX, fixed odds, admin settle).
model PredictionEvent {
  id               Int                   @id @default(autoincrement())
  slug             String                @unique
  /// Russian (primary)
  title            String
  titleEn          String?
  description      String?
  descriptionEn    String?
  category         String                @default("other")
  imageUrl         String?
  bannerUrl        String?
  /// Optional home-hero / detail video (mp4 URL or YouTube/Twitch/Kick embed)
  videoUrl         String?
  resolveRule      String?
  resolveRuleEn    String?
  status           PredictionEventStatus @default(DRAFT)
  closesAt         DateTime?
  resolvesAt       DateTime?
  winningOutcomeId Int?
  settledAt        DateTime?
  /// Soft-hide from public hub/detail; keep history & admin access.
  archivedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  outcomes         PredictionOutcome[]
  bets             PredictionBet[]
  comments         PredictionComment[]
  bookmarks        PredictionBookmark[]

  @@index([status, closesAt])
  @@index([category, status])
  @@index([archivedAt])
}

model PredictionComment {
  id        Int                     @id @default(autoincrement())
  eventId   Int
  userId    Int
  /// Optional parent for one-level replies (Polymarket-style threads).
  parentId  Int?
  body      String                  @db.VarChar(280)
  /// Optional GIF from allowlisted CDN (Tenor/Giphy).
  gifUrl    String?                 @db.VarChar(512)
  status    PredictionCommentStatus @default(VISIBLE)
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  event     PredictionEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    PredictionComment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   PredictionComment[]     @relation("CommentReplies")
  likes     PredictionCommentLike[]

  @@index([eventId, createdAt])
  @@index([userId, createdAt])
  @@index([eventId, status, createdAt])
  @@index([parentId, createdAt])
}

model PredictionCommentLike {
  id        Int               @id @default(autoincrement())
