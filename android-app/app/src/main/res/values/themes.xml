<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ImbaBet" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/imba_bg</item>
        <item name="android:statusBarColor">@color/imba_bg</item>
        <item name="android:navigationBarColor">@color/imba_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.ImbaBet.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/imba_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.ImbaBet</item>
    </style>
</resources>
