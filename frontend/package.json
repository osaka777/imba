{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 8000",
    "dev:fast": "next dev -p 8000",
    "dev:optimized": "next dev -p 8000 -c next.config.optimized.js",
    "dev:win": "set NODE_ENV=development && next dev -p 8000 -c next.config.optimized.js",
    "dev:https": "next dev -p 8000 --experimental-https",
    "dev:prebuild": "npm run build && npm run start",
    "dev:prebuild:fast": "npm run build && npm run start",
    "build": "next build",
    "build:fast": "next build",
    "build:no-schema": "next build",
    "start": "next start -p 8000",
    "start:fast": "next start -p 8000",
    "lint": "next lint --fix",
    "format": "prettier --write \"**/*.{js,ts,tsx,json,css}\"",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/check-i18n.mjs",
    "generate-schema": "openapi-typescript https://imba.bet/api/docs-json -o ./src/shared/api/api.d.ts || true"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-tailwindcss"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tanstack/react-query": "^5.45.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "currency-symbol-map": "^5.1.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.11",
    "hls.js": "^1.6.2",
    "next": "^15.4.2",
    "next-nprogress-bar": "^2.3.12",
    "openapi-fetch": "^0.9.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "react-icons": "^5.5.0",
    "react-infinite-scroller": "^1.2.6",
    "react-toastify": "^10.0.5",
    "react-use-websocket": "^4.8.1",
    "sharp": "^0.33.4",
    "swiper": "^11.1.3",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "use-debounce": "^10.0.1",
    "usehooks-ts": "^3.1.0",
    "user-agents": "^1.1.233",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tanstack/eslint-plugin-query": "^5.35.6",
    "@tanstack/react-query-devtools": "^5.45.0",
    "@types/node": "^20.12.12",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@types/react-infinite-scroller": "^1.2.5",
    "@types/user-agents": "^1.0.4",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.4.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-perfectionist": "^2.10.0",
    "openapi-typescript": "^6.7.6",
    "postcss": "^8.4.38",
    "prettier": "^3.3.1",
    "prettier-plugin-tailwindcss": "^0.6.2",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
